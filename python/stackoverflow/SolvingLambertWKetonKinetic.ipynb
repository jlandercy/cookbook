     "start_time": "2025-04-06T08:52:37.662053Z"
    }
   },
   "outputs": [],
   "source": [
    "import sympy as sp"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "id": "4c5729b4",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-04-06T08:52:38.388945Z",
     "start_time": "2025-04-06T08:52:38.382921Z"
    }
   },
   "outputs": [],
   "source": [
    "t, xi, k1, k2, n = sp.symbols(\"t xi k1 k2 n\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "e4cb4373",
   "metadata": {},
   "outputs": [],
   "source": []
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "acdfa16b",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-04-06T08:52:38.474146Z",
     "start_time": "2025-04-06T08:52:38.394561Z"
    }
   },
   "outputs": [],
   "source": [
    "g1 = 1 + k2 * xi / (n - xi)\n",
    "g2 = k1"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "3d3e2c85",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-04-06T08:52:38.651140Z",
     "start_time": "2025-04-06T08:52:38.477981Z"
    }
   },
   "outputs": [],
   "source": [
    "h1 = sp.integrate(g1, (xi, 0, xi))\n",
    "h2 = sp.integrate(g2, (t, 0, t))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "db823f4c",
   "metadata": {
    "ExecuteTime": {
     "end_time": "2025-04-06T08:52:40.097096Z",
     "start_time": "2025-04-06T08:52:38.654071Z"
    }
   },
   "outputs": [
    {
     "data": {
      "text/plain": [
       "[n*(k2*LambertW((1 - k2)*exp((-k1*t - k2*n + n)/(k2*n))/k2) + k2 - 1)/(k2 - 1)]"
      ]
     },
     "execution_count": 5,
     "metadata": {},
     "output_type": "execute_result"
    }
   ],
   "source": [
    "sol = sp.solve(sp.Eq(h1, h2), xi)\n",
    "sol"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "1b5a2b3a",
   "metadata": {},
   "outputs": [],
   "source": []
  }
